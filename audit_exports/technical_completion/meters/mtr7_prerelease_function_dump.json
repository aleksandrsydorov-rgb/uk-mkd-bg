      "def": "CREATE OR REPLACE FUNCTION public.tariff_rates_json(p_version_id uuid)\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select coalesce(\n    jsonb_object_agg(ri.component_key, ri.rate order by ri.component_key),\n    '{}'::jsonb\n  )\n  from public.tariff_rate_items as ri\n  where ri.version_id = p_version_id\n    and ri.subject_kind = 'natural';\n$function$\n",
      "name": "tariff_rates_json"
    },
    {
      "args": "p_version_id uuid, p_subject_kind text",
      "def": "CREATE OR REPLACE FUNCTION public.tariff_rates_json(p_version_id uuid, p_subject_kind text)\n RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select coalesce(\n    (\n      select jsonb_object_agg(ri.component_key, ri.rate order by ri.component_key)\n      from public.tariff_rate_items as ri\n      where ri.version_id = p_version_id\n        and ri.subject_kind = coalesce(nullif(btrim(p_subject_kind), ''), 'natural')\n    ),\n    '{}'::jsonb\n  );\n$function$\n",
      "name": "tariff_rates_json"
