# AMADEUS 11 RC8 — DB install secrets (VPS host file ONLY)
# Typical path: /etc/amadeus11/rc8-db-install.env  (chmod 0600, owner root:ops)
# NEVER commit a filled copy. NEVER bake into Docker images.
#
# Copy:
#   cp env.example /etc/amadeus11/rc8-db-install.env
#   chmod 0600 /etc/amadeus11/rc8-db-install.env

# Must equal --confirm-project. Cloud installs require:
#   SUPABASE_URL host = {ref}.supabase.co
#   DATABASE_URL user = postgres.{ref} and/or host db.{ref}.supabase.co / pooler containing {ref}
CONFIRM_PROJECT=rkiahcmemyocoyznfohc

# Postgres connection URI (Supabase → Database settings).
# Prefer direct (5432) for DDL; session pooler (6543) may work — stop on first error either way.
# Password may sit in the URI userinfo OR in DATABASE_PASSWORD below.
# The installer never puts the password on the psql process argv (uses PGPASSWORD).
DATABASE_URL=postgresql://postgres.your-supabase-project-ref:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DATABASE_PASSWORD=YOUR_DB_PASSWORD


# Public project URL (used only to verify CONFIRM_PROJECT before any write).
SUPABASE_URL=https://your-supabase-project-ref.supabase.co

# Keys kept in the same closed file for later First Boot / app env — installer SQL path
# does not send them to the database. Leave blank only if unused on this host.
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local disposable Supabase only (127.0.0.1 / localhost). Leave unset/false on VPS.
# ALLOW_LOCAL_INSTALL=true

# Optional local-only: use docker exec instead of host psql (ops workstation without psql).
# Leave unset on VPS — install PostgreSQL client and use DATABASE_URL directly.
# PSQL_DOCKER_CONTAINER=supabase_db_amadeus11-rc8-storage-fi
